package engine

import "core:fmt"
import "core:mem"
import "core:strings"

CODEGEN_HEADER :: `// Generated by miraidb from the database schema. Do not edit.
// Run ` + "`" + `miraidb codegen <database>` + "`" + ` again after a schema change.
package generated

`

// codegen_odin renders every user table as an Odin struct, in name order.
codegen_odin :: proc(host: ^Host, alloc: mem.Allocator) -> string {
	names := make([dynamic]string, 0, len(host.store.tables), alloc)
	for name in host.store.tables {
		if len(name) > 0 && name[0] == '_' do continue
		append(&names, name)
	}
	slice_sort_strings(names[:])
	builder := strings.builder_make(alloc)
	fmt.sbprint(&builder, CODEGEN_HEADER)
	for name in names {
		result, describe_err := sql_execute(host.store, fmt.tprintf("DESCRIBE %s", name))
		if describe_err.kind != .None do continue
		fmt.sbprintfln(&builder, "Row_%s :: struct {{", name)
		for row in result.rows {
			if row[0].s != "column" do continue
			fmt.sbprintfln(&builder, "\t%s: %s,", row[1].s, codegen_type(row[2].s))
		}
		fmt.sbprint(&builder, "}\n\n")
		sql_result_destroy(&result)
	}
	return strings.to_string(builder)
}

@(private)
codegen_type :: proc(sql_type: string) -> string {
	upper := strings.to_upper(sql_type)
	defer delete(upper)
	switch {
	case strings.contains(upper, "128"):
		return "i128"
	case strings.contains(upper, "INT"), strings.contains(upper, "DURATION"):
		return "i64"
	case strings.contains(upper, "REAL"), strings.contains(upper, "FLOAT"), strings.contains(upper, "F64"), strings.contains(upper, "DOUBLE"), strings.contains(upper, "NUMERIC"):
		return "f64"
	case strings.contains(upper, "F32"):
		return "f32"
	case strings.contains(upper, "BOOL"):
		return "bool"
	case strings.contains(upper, "BLOB"), strings.contains(upper, "BYTES"):
		return "[]u8"
	case:
		return "string"
	}
}
